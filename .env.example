# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# All values below are dummy values for local development. Never commit real secrets.

# --- API settings (read by app/config/base.py) ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Used when the API runs on your machine (`make run`). Under Docker Compose the
# API gets its own DATABASE_URL and REDIS_URL that point at the `db` and `redis`
# services, built from the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://savely:change-me@localhost:5432/savely
REDIS_URL=redis://localhost:6379/0
# Length of the embedding vectors, 1 to 2000. It must match the embedding model.
# 1024 is the size chosen for openai/text-embedding-3-large (SAV-7).
# The first migration creates the embedding columns with this size. Changing it
# afterwards needs a new migration and embedding everything again.
EMBEDDING_DIMENSION=1024

# --- Instagram webhook (read by app/config/base.py) ---
# The Meta app's secret (App settings → Basic). Meta signs every webhook with it.
META_APP_SECRET=change-me
# Any long random text. Enter the same value as "Verify token" in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=change-me
# Upper bound for collection hints: only a text sent this many seconds or less after a
# share may name that item's collection, and the chat worker asks the decision model
# whether it does (COLLECTION_HINT_MIN_PROBABILITY). A later text is answered as chat
# with no model call. 9 seconds was the gap in the recorded webhooks (decision records
# 0002 and 0018).
COLLECTION_HINT_WINDOW_SECONDS=30
# How long ingestion keeps a user's job payloads, text receipts and recent shares
# in Redis. Meta delivers a failed webhook again for up to 36 hours (Graph API
# webhooks documentation), so 36 hours = 129600 seconds. At least the hint window.
INGESTION_STATE_TTL_SECONDS=129600

# --- Docker Compose: Postgres container ---
POSTGRES_USER=savely
POSTGRES_PASSWORD=change-me
POSTGRES_DB=savely

# --- Docker Compose: ports published on 127.0.0.1 ---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Model clients (read by app/config/models.py, ModelSettings; see docs/development.md "Models") ---
# Every model call goes through OpenRouter with this one key. Never commit a real key.
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The decisions endpoint has its own URL. It is not chat completions.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# A call that fails with a timeout, a rate limit or a server error is tried this
# many times in total. The wait starts at the base delay, doubles each time and
# never passes the maximum.
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_DELAY_SECONDS=0.5
OPENROUTER_RETRY_MAX_DELAY_SECONDS=8

# Fixed decisions (type, tags, is-list, which candidate, …).
DECISION_MODEL=google/gemini-decision-1
DECISION_TIMEOUT_SECONDS=30

# Extraction and the response agent.
TEXT_MODEL=deepseek/deepseek-v4.1-flash
# The ONE provider endpoint that may serve the text model. It must be hosted
# outside China (DeepSeek's own API is not). Requests are never sent to another
# provider: if this one cannot serve a call, the call fails.
# TEXT_MODEL_PROVIDER is the endpoint's OpenRouter slug. TEXT_MODEL_PROVIDER_NAME
# is the name OpenRouter reports for it in a reply's routing metadata; a reply
# not proven to come from it is discarded. This choice is a proposal awaiting the
# owner's decision; its evidence is in decision record 0010.
TEXT_MODEL_PROVIDER=coreweave/fp8
TEXT_MODEL_PROVIDER_NAME=CoreWeave
TEXT_TIMEOUT_SECONDS=30

# The video model for the rare escalation (silent reels with text overlays).
ESCALATION_MODEL=google/gemini-2.5-flash
ESCALATION_TIMEOUT_SECONDS=60

# Speech-to-text. The fallback model is asked when the default model fails or
# returns no words. The response format is `verbose_json` (language and
# timestamps) or `json` (text only); openai/gpt-transcribe rejects verbose_json.
TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
TRANSCRIPTION_FALLBACK_MODEL=openai/gpt-transcribe
TRANSCRIPTION_FALLBACK_RESPONSE_FORMAT=json
TRANSCRIPTION_TIMEOUT_SECONDS=60

# Embeddings. The vector size is EMBEDDING_DIMENSION above.
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_TIMEOUT_SECONDS=30

# --- Instagram Send API: the bot's DM replies (read by app/config/messenger.py, MessengerSettings) ---
# Base URL of the Graph API with its version. Messages go to <URL>/<INSTAGRAM_ACCOUNT_ID>/messages.
# graph.facebook.com is the host record 0004 tested with the bot's token. A token from
# "Instagram API with Instagram Login" uses https://graph.instagram.com/<version> instead.
INSTAGRAM_GRAPH_API_URL=https://graph.facebook.com/v27.0
# The bot's Instagram professional account id (the {ig-user-id} of the Send API).
INSTAGRAM_ACCOUNT_ID=17840000000000001
# The bot's access token (Meta app → Instagram → Generate access tokens). Never commit a real one.
INSTAGRAM_ACCESS_TOKEN=change-me
# Replies are sent only this long after the user's last message; older ones are skipped.
# More than 0 and at most 24, Instagram's own limit.
INSTAGRAM_REPLY_WINDOW_HOURS=24
SEND_API_TIMEOUT_SECONDS=10
# A message Meta throttles, or whose connection never opens, is tried this many times in
# total. The wait starts at the base delay, doubles each time and never passes the maximum,
# also when Meta asks for longer. A timeout or a 5xx (503 included) after the request went
# out may have delivered the message, so it is not retried.
SEND_API_MAX_ATTEMPTS=3
SEND_API_RETRY_BASE_DELAY_SECONDS=1
SEND_API_RETRY_MAX_DELAY_SECONDS=8

# --- Indexing pipeline and its worker (read by app/config/pipeline.py, PipelineSettings) ---
# The worker runs with `python -m app.pipeline.worker` and needs ffmpeg and ffprobe
# (`brew install ffmpeg` on a Mac).
# Stands in for object storage in development. Each item's media goes to
# <folder>/<user id>/<saved item id>/, and "delete my data" removes the user's folder.
MEDIA_STORAGE_DIR=./media
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
# A larger file is not downloaded; the item is then indexed from its text. 100 MB.
MEDIA_MAX_DOWNLOAD_BYTES=104857600
# Height of the stored video copy and images, in pixels. Smaller media keeps its size.
MEDIA_STORED_HEIGHT_PIXELS=360
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TOOL_TIMEOUT_SECONDS=120
# A run that times out or is cancelled by the run's deadline stops its own ffmpeg or
# ffprobe child: SIGTERM, then SIGKILL if it hasn't exited within this time.
MEDIA_TOOL_STOP_TIMEOUT_SECONDS=5
# The near-empty rule: a final transcript with fewer letters and digits than this
# counts as no speech. Letters of any script count, and so do digits and the marks
# that combine with letters; spaces, punctuation and symbols such as ♪ don't.
TRANSCRIPT_MIN_SPEECH_CHARACTERS=4
# A post counts as a list of several things from this probability of yes.
CLASSIFY_IS_LIST_MIN_PROBABILITY=0.5
EXTRACTION_TEMPERATURE=0
EXTRACTION_MAX_OUTPUT_TOKENS=2000
# The vocabulary (ARCHITECTURE §3.4). Wording enters the shared vocabulary only with
# at least this probability of being generic; anything less counts as no.
VOCAB_PRIVACY_MIN_PROBABILITY=0.9
# A candidate alias is verified after matches with at least this probability from
# at least this many different users.
VOCAB_ALIAS_MIN_PROBABILITY=0.9
VOCAB_ALIAS_MIN_USERS=3
# Longer wording, in characters, never enters the shared vocabulary.
VOCAB_MAX_VALUE_LENGTH=40
# Wording with this many digits in a row (spaces, dots, dashes, slashes and brackets
# allowed between them) looks like a phone number and never enters the vocabulary.
VOCAB_PHONE_MIN_DIGITS=7
# How many of the nearest existing values the decision model chooses from.
VOCAB_MATCH_CANDIDATES=5
# Jobs one worker runs at the same time. A bulk import fans out over every slot.
INDEXING_CONCURRENCY=10
# Runs of one job, the first included. The last run marks the item failed.
INDEXING_MAX_TRIES=5
# The wait before a job runs again, multiplied by the number of the run that failed.
INDEXING_RETRY_DELAY_SECONDS=30
# How long one run may take, from before it reads the payload to the end of its last
# step. A run that passes it stops itself, records where it was and runs again; the
# last try marks the item failed.
INDEXING_RUN_DEADLINE_SECONDS=540
# How long recording a failure may take after that, from one deadline that starts when
# the run stops. If the database doesn't answer in time (for example, the user's row is
# locked), the failure is only logged; the stuck-item sweeper repairs the item later.
INDEXING_FAILURE_RECORDING_SECONDS=20
# Time kept free for clean-up after a run is stopped: stopping and reaping a media tool
# (up to twice MEDIA_TOOL_STOP_TIMEOUT_SECONDS) and rolling back a transaction.
INDEXING_CLEANUP_RESERVE_SECONDS=30
# arq's own limit on one run, a backstop that cancels without a retry. Longer than the
# run deadline, the recording time and the clean-up reserve together (540 + 20 + 30 = 590).
INDEXING_JOB_TIMEOUT_SECONDS=600
# The stuck-item sweeper (an arq cron in the worker) runs this often. It must divide a
# minute, or be whole minutes that divide an hour.
INDEXING_SWEEP_INTERVAL_SECONDS=300
# An item still pending or enriching with no job or sweep working on it for this long
# is stuck: it is queued again if it has tries left and its payload, otherwise marked
# failed. Longer than a whole run plus every retry wait (600 + 30 x 5 = 750).
INDEXING_STALE_AFTER_SECONDS=1800
# The most stuck items one sweep repairs; the next sweep takes the rest. Items whose
# owner's row is locked are skipped and don't count against it.
INDEXING_SWEEP_BATCH_SIZE=100

# --- Search over a user's saves (read by app/config/retrieval.py, RetrievalSettings; see docs/development.md "Search") ---
# One search may take this long in total, model calls and fallback levels included.
# When it runs out, the answer has what was found by then and is marked incomplete
# (ARCHITECTURE §3.6: about 10 seconds).
SEARCH_TIME_BUDGET_SECONDS=10
# The most items one search returns.
SEARCH_MAX_RESULTS=20
# A search that finds fewer items than this relaxes its filters and also searches
# items that are not fully indexed yet (fallback level L2). 0 to 20.
SEARCH_MIN_RESULTS=3
# Filter normalization ("netflx" → Netflix): the decision model's lowest probability
# for a value that still counts as what the user meant, from 0 to 1. The owner-approved
# initial value, to be tuned on the evaluation set.
FILTER_NORMALIZATION_MIN_PROBABILITY=0.6
# The most of the user's saved values offered to the decision model for one filter.
FILTER_NORMALIZATION_MAX_OPTIONS=20
# Streaming availability older than this many days is reported as stale, so it is
# fetched again for that country.
AVAILABILITY_MAX_AGE_DAYS=7

# --- Response agent (read by app/config/agent.py, AgentSettings; see docs/development.md "Response agent") ---
# The most model calls one answer may take, tool rounds included. The last call may not
# call tools, so the agent always ends with an answer or an error. At least 2.
AGENT_MAX_STEPS=6
# The most saved items one answer sends back as replies quoting the saved reels
# (decision record 0004: about 5). The rest are kept for "show more".
AGENT_MAX_RESULTS_PER_ANSWER=5
# The longest reply the text model may write per call, in tokens.
AGENT_MAX_OUTPUT_TOKENS=600
# A verified vocabulary alias is flagged for review in the logs once this many different
# users corrected a value that came through it (ARCHITECTURE §3.4). One user's repeated
# corrections count once. At least 2; to be tuned on the evaluation set.
VOCAB_ALIAS_REVIEW_MIN_USERS=3
# "Delete my data" from the DM: how long the request waits for the user's "yes", in
# seconds, counted from when sending the question begins. Only the user's next
# message can confirm it; anything else cancels it.
DATA_DELETION_CONFIRM_SECONDS=600

# --- Chat worker and short-term memory (read by app/config/chat.py, ChatSettings; see docs/development.md "Chat worker") ---
# How long a user's short-term memory (the last messages and the working set) lives after
# the last exchange, in seconds. About 24 hours, like Instagram's reply window (ARCHITECTURE §3.7).
SESSION_TTL_SECONDS=86400
# How many of the last messages the response agent reads (ARCHITECTURE §3.7: about 20).
SESSION_HISTORY_MESSAGES=20
# How many messages one chat worker answers at once.
CHAT_CONCURRENCY=10
# How often one message's job runs before the bot sends its error message instead.
# Also how often one run tries to store an answer it sent.
CHAT_MAX_TRIES=3
# The wait before a failed chat job runs again, in seconds, times the number of the try.
# Also the wait between attempts to store a sent answer, times the attempt.
CHAT_RETRY_DELAY_SECONDS=5
# How long one try may take to prepare an answer (memory, model calls, tools), in seconds.
# Sending is not cut off by it.
CHAT_RUN_DEADLINE_SECONDS=60
# arq's own limit on one try, in seconds; longer than CHAT_RUN_DEADLINE_SECONDS, to leave
# time for sending. Only a backstop.
CHAT_JOB_TIMEOUT_SECONDS=180
# How sure the decision model must be, from 0 to 1, that a text sent right after a share
# names a collection for it ("Food", "Filmler") before it is filed as that item's
# collection. Below it, or when the model fails, the text is answered as chat: a missed
# label costs little, a swallowed question looks broken (decision record 0018). To be
# tuned on the live routing check (docs/development.md).
COLLECTION_HINT_MIN_PROBABILITY=0.7
